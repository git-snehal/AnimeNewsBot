# --- required ---
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
CHANNEL_ID=@your_channel          # or -100xxxxxxxxxx
OWNER_ID=123456789                # your Telegram user id
ADMIN_IDS=                        # more admins, comma separated (optional). Admins can use all commands

# --- optional ---
SIGNATURE=@OD3NS_ANIMES
DISCUSSION_LINK=
POLL_INTERVAL=600
DISABLED_FEEDS=                   # feed names to switch off, comma separated, e.g. Anime News Network
SEED_ON_FIRST_RUN=true            # first start: mark current feed items as seen instead of posting them
SHOW_SOURCE_BUTTON=true
SILENT_REGULAR_NEWS=true          # regular news = no notification, trailers = with sound
PIN_TRAILERS=false
DOWNLOAD_TRAILERS=true
PAGE_VIDEO_FALLBACK=true          # trailer article without a video link in the feed: look for the video on the article page
YT_SEARCH_FALLBACK=false          # search YouTube when a trailer article has no video link (can pick a wrong video)
MAX_VIDEO_MB=150
MAX_VIDEO_SECONDS=600
MAX_VIDEO_HEIGHT=720
COOKIES_PATH=cookies.txt
YTDLP_REMOTE_COMPONENTS=false     # true = let yt-dlp fetch its YouTube solver script from GitHub (prefer: pip install -U "yt-dlp[default]")

# --- daily report ---
TIMEZONE=UTC                      # e.g. Asia/Kolkata, Europe/London, America/New_York
DAILY_STATS=true
STATS_TIME=23:59                  # HH:MM in TIMEZONE
STATS_CHAT_ID=                    # optional group/channel id for the report; empty = DM every admin
