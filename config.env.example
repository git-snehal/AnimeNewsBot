# --- required ---
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
CHANNEL_ID=@your_channel          # or -100xxxxxxxxxx
OWNER_ID=123456789                # your Telegram user id
ADMIN_IDS=                        # more admins, comma separated (optional). Admins can use all commands
CONTROL_GROUP_ID=                 # optional admins-only group (-100...): admin commands and /logs work there too

# --- look ---
SIGNATURE=@OD3NS_ANIMES           # also printed on the rating cards and Netflix charts
DISCUSSION_LINK=
SHOW_SOURCE_BUTTON=true
SILENT_REGULAR_NEWS=true          # regular news = no notification, trailers = with sound
PIN_TRAILERS=false
PORTRAIT_IMAGES=true              # prefer a portrait key visual / poster from inside the article

# --- feeds ---
POLL_INTERVAL=600
BLOCKED_WORDS=puzzles vol,recap   # whole words/phrases; titles containing them are never posted
DISABLED_FEEDS=                   # feed names to switch off, comma separated, e.g. YouTube: Muse Asia
SEED_ON_FIRST_RUN=true            # a feed seen for the first time: mark its current items as seen instead of posting them
PAGE_PROXY=                       # proxy for sites that answer 403 (ANN), e.g. Cloudflare WARP: socks5://127.0.0.1:40000

# --- trailers ---
DOWNLOAD_TRAILERS=true
PAGE_VIDEO_FALLBACK=true          # look for the video on the article page if the feed has none
YT_SEARCH_FALLBACK=true           # last resort: strict YouTube search (matches English, romaji and other names)
MAX_VIDEO_MB=150
MAX_VIDEO_SECONDS=600
MAX_VIDEO_HEIGHT=720
COOKIES_PATH=cookies.txt
YTDLP_AUTO_UPDATE=true            # once a day: update yt-dlp + its solver, restart the bot only if something changed
YTDLP_UPDATE_PRE=false            # true = nightly builds of yt-dlp itself (its dependencies stay on normal releases)
YOUTUBE_POT_ENABLED=true          # use the PO-token provider when it is running (see README)
YOUTUBE_POT_URL=http://127.0.0.1:4416
YTDLP_PROXY=                      # optional proxy for YouTube only, e.g. socks5://127.0.0.1:40000
YTDLP_REMOTE_COMPONENTS=auto      # auto | off | ejs:github | ejs:npm
YTDLP_JS_RUNTIME_PATH=            # only if the bot can't find deno/node by itself, e.g. /root/.deno/bin/deno

# --- Netflix Top 10 (weekly, official Netflix data) ---
NETFLIX_TOP10=true
NETFLIX_MAX_ROWS=6                # anime shown on the chart (1-8)

# --- IMDb episode ratings (IMDb's free non-commercial data) ---
IMDB_RATINGS=true
IMDB_MIN_RATING=8.5               # post an episode once it reaches this rating...
IMDB_MIN_VOTES=300                # ...with at least this many votes
IMDB_MAX_PER_DAY=3
IMDB_TRACK_SHOWS=60               # follow the N most popular airing anime

# --- optional: TMDB (free key at themoviedb.org/settings/api) ---
TMDB_API_KEY=                     # sharper posters on the cards, and marks live-action titles in the Netflix chart

# --- daily report ---
TIMEZONE=UTC                      # e.g. Asia/Kolkata, Europe/London, America/New_York
DAILY_STATS=true
STATS_TIME=23:59                  # HH:MM in TIMEZONE
STATS_CHAT_ID=                    # optional group/channel id for the report; empty = DM every admin
